# ServiceSetu - deployment configuration
#
#   cp .env.docker.example .env
#   then fill in the marked values and keep the file off git.
#
# The name `.env` matters - compose reads it automatically for every command.
#
# Read by docker compose and passed into the API container. Never baked into
# an image.

# ============================================================ the basics
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Where the site is reached. Used in the links inside emails, so getting it
# wrong sends customers to a URL that does not resolve.
#
# INCLUDE THE PORT if the site is not on 80. An origin is scheme + host +
# port, and these are compared exactly.
APP_URL=https://services.hiideals.com

# Origins allowed to call the API, comma-separated, matched exactly.
#
# The app and the API share one origin behind nginx, so this should never be
# exercised in normal use - but browsers send an Origin header on every POST,
# including same-origin ones, so a mismatch here rejects registration and
# sign-in with "Origin ... is not allowed".
#
# Must carry the port when the site is not on 80. Add the LAN address too if
# the server is reachable both ways:
#   CORS_ORIGINS=https://services.hiideals.com,http://192.168.29.193:8082
CORS_ORIGINS=https://services.hiideals.com

# ---------------------------------------------------------------- !! ----
# MUST be false while the site is served over plain HTTP.
#
# A Secure cookie is refused by the browser on an insecure origin - silently,
# with no console error. Sign-in appears to succeed and then the session is
# gone on the next page load.
# True because Cloudflare terminates TLS and the browser is on https. Set it
# to false ONLY if you go back to serving plain http - a Secure cookie is
# silently dropped on an insecure origin, which looks like a session bug.
COOKIE_SECURE=true
# ------------------------------------------------------------------------

# ========================================================== the database
# `db` is the compose service name; docker resolves it on the private network.
DB_HOST=db
DB_PORT=5432
DB_NAME=servicesetu
DB_USER=postgres

# CHANGE THIS. The database is not published to the LAN, but a weak password
# here is still the last thing standing if anything else is misconfigured.
DB_PASSWORD=change-me-to-something-long

DB_SSL=false
DB_POOL_MAX=10

# ============================================================== secrets
# CHANGE BOTH. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing them later signs every user out, which is the correct behaviour and
# worth knowing before you do it on a busy evening.
JWT_ACCESS_SECRET=replace-with-48-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-48-random-bytes

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ========================================================= the platform
PLATFORM_COMMISSION_PERCENT=15
BOOKING_ACCEPT_WINDOW_MINUTES=60
DISPUTE_WINDOW_HOURS=48
PAYOUT_MODE=manual

# ========================================================== file storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Where uploaded documents live ON THE HOST.
#
# KYC identity documents end up here, under private/kyc/<provider-id>/. They
# are the evidence behind every verification decision ever made and cannot be
# regenerated, so this folder is what your backups must cover.
#
# Relative paths are resolved from this directory. An absolute path works too
# and is the better choice if you want them on a different disk:
#   UPLOADS_PATH=/srv/servicesetu/uploads
#
# Create it before the first start, owned by uid 1000 - the container runs as
# a non-root user and cannot write to a folder Docker created as root:
#   mkdir -p data/uploads && sudo chown -R 1000:1000 data/uploads
UPLOADS_PATH=./data/uploads

# ============================================================== backups
# A backup is a pg_dump of the database PLUS an archive of the uploads folder
# above. Either one alone cannot rebuild this platform.
#
# Both the scheduled job and the "Back up now" button in the admin console
# write here. Inside the container this is /app/backups; on the host it is
# BACKUPS_PATH below.
BACKUP_DIR=backups

# How often the scheduled backup runs, in hours. 0 turns it off and leaves
# only the manual button.
BACKUP_EVERY_HOURS=24

# How many runs to keep before the oldest is deleted. Seven daily backups is
# a week of history; raise it if the disk can take it. Each run is roughly the
# size of your database plus your uploads folder, compressed.
BACKUP_KEEP=7

# Whether each backup includes the uploaded KYC documents. Leave this on. The
# documents cannot be regenerated from anything, and a database restored
# without them has a verification record pointing at files that do not exist.
BACKUP_INCLUDE_UPLOADS=true

# Where the backups live ON THE HOST.
#
# Create it before the first start, owned by uid 1000, exactly like the
# uploads folder:
#   mkdir -p data/backups && sudo chown -R 1000:1000 data/backups
#
# IMPORTANT: this is still the same machine as the database. Copying these
# files off the server is a separate step - DEPLOY.md has the cron line.
BACKUPS_PATH=./data/backups

# ================================================ two-factor authentication
# Encrypts the TOTP secrets of admins who switch on two-factor sign-in.
#
# Without it, 2FA cannot be turned on - the account screen says so rather than
# the server refusing to start. With it, the secrets are encrypted at rest, so
# a stolen database backup does not hand over the second factor along with the
# password hashes.
#
# Generate one with:   openssl rand -hex 32
#
# Set it ONCE and leave it alone. Changing it invalidates every enrolled
# authenticator app: everyone with 2FA on is locked out and must use a
# recovery code, then set it up again.
TOTP_ENCRYPTION_KEY=

# ============================================================= payments
# Stays on the mock driver until you are ready to take real money. Switching
# to razorpay without the three values below will fail at boot, deliberately.
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-string

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ================================================================ email
# Codes and booking notifications. On `console` they are only printed to the
# container log, which means nobody can actually confirm an account.
EMAIL_DRIVER=smtp
EMAIL_FROM=ServiceSetu <your-address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# EMAIL_FROM must match SMTP_USER for Gmail. A mismatch fails SPF and the mail
# is dropped or filed as spam with no bounce - this has already happened once.

# ============================================================= whatsapp
# Verification codes go here first and fall back to email when WhatsApp
# cannot carry them - a number not on WhatsApp, a paused template, an expired
# token. The fallback means nobody is ever locked out of registering.
#
# Set OTP_CHANNEL=email to keep codes on email only.
OTP_CHANNEL=whatsapp

# `console` logs the code instead of sending it, which is what development
# uses. `cloud` talks to Meta and needs the three values below.
WHATSAPP_DRIVER=cloud

# WhatsApp -> API Setup in the Meta app dashboard. This is the Phone number
# ID, a long number - NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# A System User token with whatsapp_business_messaging and
# whatsapp_business_management, expiry Never. The token shown on the API Setup
# page lasts 24 hours and is no use here.
WHATSAPP_ACCESS_TOKEN=

# The approved template's exact name, and its language code. Meta treats `en`
# and `en_US` as different templates and the error does not say which it
# wanted.
WHATSAPP_TEMPLATE_NAME=servicesetu_otp
WHATSAPP_TEMPLATE_LANGUAGE=en

# Authentication templates normally carry a copy-code button, which needs the
# code supplied a second time. Set false if yours has no button, or Meta
# rejects every message with a component-mismatch error.
WHATSAPP_TEMPLATE_HAS_BUTTON=true

# =============================================================== logging
LOG_LEVEL=info
LOG_HTTP=errors

# ============================================================== compose
# The port nginx publishes on the host.
#
# With the tunnel this is only ever reached from the same machine, so the
# number matters little - but it must be free. 80 and 8080 are already taken
# on this server, which is why this is 8082.
# The domain Caddy obtains a certificate for. Must already resolve to this
# server's public IP, or the ACME challenge fails and no certificate is issued.
SITE_DOMAIN=services.hiideals.com

# nginx, published on loopback only - Caddy reaches it over the compose
# network. Useful for curling the stack from the server while debugging.
WEB_PORT=8082

# ============================================================== tunnel
# From the Cloudflare Zero Trust dashboard:
#   Networks -> Tunnels -> Create a tunnel -> Cloudflared
# Copy the token out of the install command it shows you - the long string
# after `--token`. It is a credential: it lets anything holding it serve
# traffic on your domain.
CLOUDFLARE_TUNNEL_TOKEN=
