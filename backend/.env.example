# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Base URL of the frontend, used for links inside notification emails.
APP_URL=http://localhost:5175
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:3000

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicesetu
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---------- Platform defaults ----------
PLATFORM_COMMISSION_PERCENT=15
BOOKING_ACCEPT_WINDOW_MINUTES=60
# manual = an admin transfers the money and marks it paid. gateway = automatic.
PAYOUT_MODE=manual
DISPUTE_WINDOW_HOURS=48

# ---------- Optional infrastructure ----------
# Leave REDIS_URL blank to use the in-memory cache/queue fallback
REDIS_URL=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# ---------- backups ----------
# pg_dump of the database plus a tar of UPLOAD_DIR, written here. The admin
# console takes them on demand and the scheduler takes one every
# BACKUP_EVERY_HOURS (0 turns the schedule off).
#
# Needs pg_dump on PATH, matching the server's major version. If several
# PostgreSQL versions are installed, point PG_DUMP_PATH at the right one:
#   PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# ---------- two-factor authentication ----------
# Encrypts TOTP secrets at rest. Empty means 2FA cannot be switched on.
# Generate with: openssl rand -hex 32
# Changing it later locks out every enrolled authenticator.
TOTP_ENCRYPTION_KEY=

BACKUP_DIR=backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
BACKUP_INCLUDE_UPLOADS=true
MAX_UPLOAD_MB=5

# ---------- Payments ----------
# 'mock' is the built-in test double. Switch to 'razorpay' once the keys below
# are filled in; the app fails to start if you switch without them.
PAYMENT_DRIVER=mock

# Razorpay. Get these from the dashboard: Settings -> API Keys (test mode).
# The webhook secret is set by you when you create the webhook, under
# Settings -> Webhooks. It is NOT the same as the key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used by the mock driver only.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Email ----------
# Verification codes go by email rather than SMS, because every SMS costs
# money and a verification code is the highest-volume message we send.
# 'console' prints the code to the log, so sign-up works with no mail server.
EMAIL_DRIVER=console
EMAIL_FROM=ServiceMitra <no-reply@servicesetu.in>

# Only needed when EMAIL_DRIVER=smtp.
# Gmail: smtp.gmail.com / 587 / your address / an App Password (not your
# account password). Brevo, Resend and Mailgun all work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Kept for booking alerts where reaching someone on site matters. Not used
# for verification codes any more.
SMS_DRIVER=console

# Logging.
#   LOG_HTTP  off | errors | all   (dev defaults to errors, production to all)
#   LOG_LEVEL trace | debug | info | warn | error   (leave unset for the default)
LOG_HTTP=errors
