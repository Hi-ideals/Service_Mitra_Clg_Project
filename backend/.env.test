# Test overrides.
#
# Loaded before .env, and the first definition of a variable wins - so these
# keep the suite off the live payment gateway and the real mail server no
# matter what .env says. Never put real credentials in here.
NODE_ENV=test

# A database of its own.
#
# Without this the suite runs against the development database: admin.test.js
# performs a real payout run on every execution, and its cleanup leaves the
# payout records behind. That is how the dev ledger ended up showing payouts
# that never happened.
DB_NAME=servicesetu_test

# Its own upload directory too. The KYC tests genuinely write files, and
# without this they accumulate in the real uploads folder as documents no
# database row points at.
UPLOAD_DIR=uploads-test
BACKUP_DIR=backups-test
# Two, so the retention test has something to prove.
BACKUP_KEEP=2

# Any value works; the suite only needs the secrets to be encryptable.
TOTP_ENCRYPTION_KEY=test-totp-key-not-a-real-one

# Off for the suite at large, so the three hundred tests that sign in as an
# admin stay about what they are actually testing. The enforcement itself is
# tested in admin2fa.test.js, which turns it on for its own process.
REQUIRE_ADMIN_2FA=false
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=test-webhook-secret
EMAIL_DRIVER=console
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret

# WhatsApp never leaves the machine during a test run.
#
# .env.test is loaded first and .env fills the gaps, so anything not pinned
# here is inherited from the real configuration - which is how the suite
# started trying to send live WhatsApp messages to invented phone numbers the
# moment real credentials were added to .env.
OTP_CHANNEL=email
WHATSAPP_DRIVER=console
WHATSAPP_PHONE_NUMBER_ID=test-phone-number-id
WHATSAPP_ACCESS_TOKEN=test-token
WHATSAPP_TEMPLATE_NAME=test_template
