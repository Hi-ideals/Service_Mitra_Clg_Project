{
  "name": "servicesetu-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ServiceMitra - Local Service Marketplace API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "migrate:down": "node src/db/migrate.js down",
    "db:create": "node src/db/createDatabase.js",
    "seed": "node src/db/seed.js",
    "seed:catalogue": "node src/db/seed.js --catalogue-only",
    "db:reset": "node src/db/migrate.js reset && node src/db/migrate.js up && node src/db/seed.js",
    "security:probe": "node scripts/security-probe.mjs security-report.json",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  }
}
